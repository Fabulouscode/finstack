# ---------------------------------------------------------------------------
# FinStack environment variables
# Copy to .env and adjust. Never commit .env.
#
# docker-compose.yml also reads this file: DATABASE_PORT, REDIS_PORT and PORT
# are the host ports it publishes, so change them if they clash locally.
# ---------------------------------------------------------------------------

# App
# One of: development | test | production
NODE_ENV=development
PORT=3000
# Swagger UI at /docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# HTTP
# Comma-separated allowed browser origins, or *. Empty disables CORS.
CORS_ORIGINS=
# Reverse proxies in front of the app (so rate limiting sees the real client IP)
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finstack
DATABASE_PASSWORD=finstack
DATABASE_NAME=finstack
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=10

# Redis
REDIS_PORT=6379
