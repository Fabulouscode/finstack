# ---------------------------------------------------------------------------
# FinStack environment variables
# Copy to .env and adjust. Never commit .env.
#
# docker-compose.yml also reads this file: DATABASE_PORT, REDIS_PORT and PORT
# are the host ports it publishes, so change them if they clash locally.
# ---------------------------------------------------------------------------

# App
# One of: development | test | production
NODE_ENV=development
PORT=3000
# Swagger UI at /docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# HTTP
# Comma-separated allowed browser origins, or *. Empty disables CORS.
CORS_ORIGINS=
# Reverse proxies in front of the app (so rate limiting sees the real client IP)
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Stricter limit for login, register and refresh
AUTH_RATE_LIMIT_MAX=10

# Auth
# HMAC key for access tokens (min 32 chars). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=finstack
JWT_AUDIENCE=finstack-api

# Idempotency (Idempotency-Key header on money-moving endpoints)
IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60

# Wallets
# single: one wallet per user, foreign payments are converted into it.
# multiple: one wallet per allowed currency; the first is primary.
WALLETS_PER_OWNER=single
# Currency of the first/primary wallet when none is given.
DEFAULT_WALLET_CURRENCY=USD
# Comma-separated currencies users may open wallets in. Defaults to DEFAULT_WALLET_CURRENCY only.
ALLOWED_WALLET_CURRENCIES=USD

# Payments
# Enabled providers (comma-separated). "mock" is for development and is refused in production.
PAYMENT_PROVIDERS=mock
DEFAULT_PAYMENT_PROVIDER=mock
# Pin currencies to providers (each provider must be enabled and able to charge it), e.g.
# PAYMENT_CURRENCY_ROUTES=USD:stripe,NGN:paystack
# HMAC secret the mock provider signs webhooks with (min 16 chars)
MOCK_PROVIDER_WEBHOOK_SECRET=change-me-mock-webhook-secret
# Paystack (add "paystack" to PAYMENT_PROVIDERS). sk_test_ keys outside production only.
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_TIMEOUT_MS=10000
# Stripe (add "stripe" to PAYMENT_PROVIDERS). sk_test_ keys outside production only.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_SUCCESS_URL=https://app.example.com/payments/success
# STRIPE_CANCEL_URL=https://app.example.com/payments/cancelled
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# FX (payments in other currencies are converted into the wallet's base currency)
# Platform margin in basis points (100 = 1%)
FX_SPREAD_BPS=100
# How long a quoted rate stays valid
FX_QUOTE_TTL_SECONDS=900
# Refuse to quote on rates older than this
FX_RATE_MAX_AGE_SECONDS=86400

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finstack
DATABASE_PASSWORD=finstack
DATABASE_NAME=finstack
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=10

# Redis (queues)
REDIS_HOST=localhost
REDIS_DB=0
# Namespaces queue keys so several apps/environments can share one Redis
QUEUE_PREFIX=finstack

# Background jobs
# Run the outbox relay and queue workers in this process (false for API-only instances)
WORKERS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
WEBHOOK_MAX_ATTEMPTS=8
# First retry delay; doubles each attempt
WEBHOOK_RETRY_BACKOFF_MS=2000

REDIS_PORT=6379
