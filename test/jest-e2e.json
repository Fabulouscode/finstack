{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": [
    "reflect-metadata",
    "<rootDir>/setup-env.ts"
  ],
  "globalSetup": "<rootDir>/global-setup.ts"
}
